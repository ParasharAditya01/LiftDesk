VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Optional Cloudflare Turnstile site key for public member OTP abuse protection.
VITE_TURNSTILE_SITE_KEY=
# Legacy Supabase anon keys are also supported by src/lib/supabase.ts.
# Never put a service_role or secret key in a VITE_ variable.
